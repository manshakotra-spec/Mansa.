# Node Environment
NODE_ENV=development
NODE_OPTIONS=--max-old-space-size=2048

# Server Configuration
PORT=5678
HOST=localhost

# Database Configuration
DB_TYPE=sqlite
DB_SQLITE_DATABASE_FILE=./n8n.db

# For PostgreSQL (uncomment and configure for production)
# DB_TYPE=postgresdb
# DB_POSTGRESDB_HOST=localhost
# DB_POSTGRESDB_PORT=5432
# DB_POSTGRESDB_USER=postgres
# DB_POSTGRESDB_PASSWORD=password
# DB_POSTGRESDB_DATABASE=n8n_db

# AI Configuration
VUE_APP_GEMINI_API_KEY=your_gemini_api_key_here
VUE_APP_ENABLE_AI_ASSISTANT=true
VUE_APP_API_URL=http://localhost:5678

# N8N Configuration
N8N_BASIC_AUTH_ACTIVE=true
N8N_BASIC_AUTH_USER=admin
N8N_BASIC_AUTH_PASSWORD=change_me_in_production
N8N_PROTOCOL=http
N8N_HOST=localhost
N8N_PORT=5678

# Security Keys (Generate new keys for production)
ENCRYPTION_KEY=change_this_in_production_with_strong_key
JWT_SECRET=change_this_in_production_with_strong_secret

# Logging
N8N_LOG_LEVEL=info
LOG_OUTPUT=console
# LOG_FILE=/tmp/n8n.log

# Feature Flags
FEATURE_FLAGS_n8n_aigeneration=true
FEATURE_FLAGS_workflowHistory=true
FEATURE_FLAGS_debugInEditor=true
FEATURE_FLAGS_advancedPermissions=false

# Optional: Redis (for caching and job queue)
# REDIS_URL=redis://localhost:6379

# Telemetry (disable for privacy)
N8N_DIAGNOSTICS_ENABLED=false
CRASH_ANALYTICS_ENABLED=false
POSTHOG_ENABLED=false

# CORS Configuration
CORS_ORIGIN=http://localhost:3000,http://localhost:5678
CORS_CREDENTIALS=true

# API Configuration
API_RATE_LIMIT=100
API_RATE_WINDOW=15m

# Execution Configuration
EXECUTION_TIMEOUT=3600000
MAX_WORKFLOW_SIZE=16777216
